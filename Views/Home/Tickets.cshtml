@model IEnumerable<ResolveDesk.Models.Ticket>
@{ViewData["Title"]="All Tickets";}
<form class="filters" method="get"><input name="search" value="@Context.Request.Query["search"]" placeholder="Search ticket number or subject"/><select name="status"><option value="">All statuses</option>@foreach(var s in Enum.GetValues<ResolveDesk.Models.TicketStatus>()){<option value="@s">@s</option>}</select><button>Filter</button></form><section class="panel"><table><thead><tr><th>Ticket</th><th>Requester</th><th>Priority</th><th>Status</th><th>Department</th><th>Updated</th></tr></thead><tbody>@foreach(var t in Model){<tr><td><a asp-action="Details" asp-route-id="@t.Id"><b>@t.Number</b><br/><span>@t.Subject</span></a></td><td>@t.Requester.DisplayName</td><td><em class="priority @t.Priority.ToString().ToLower()">@t.Priority</em></td><td><em class="status">@t.Status</em></td><td>@t.Department.Name</td><td>@t.UpdatedUtc.ToLocalTime().ToString("dd MMM HH:mm")</td></tr>}</tbody></table></section>
