@model IEnumerable<ResolveDesk.Models.Ticket>
@{ ViewData["Title"]="Kanban Board"; var stages = new[]{ResolveDesk.Models.TicketStatus.New,ResolveDesk.Models.TicketStatus.Open,ResolveDesk.Models.TicketStatus.InProgress,ResolveDesk.Models.TicketStatus.WaitingForCustomer,ResolveDesk.Models.TicketStatus.Resolved}; }
<div class="board-head"><div><h2>Ticket workflow</h2><small>Tickets are grouped by their current server-validated status.</small></div><a class="button" asp-action="Tickets">List view</a></div>
<section class="kanban-cols">@foreach(var stage in stages){var tickets=Model.Where(x=>x.Status==stage).ToList();<div class="kanban-col"><div class="kanban-col-header"><span>@stage</span><b>@tickets.Count</b></div>@foreach(var t in tickets){<a class="kanban-card" asp-action="Details" asp-route-id="@t.Id"><span class="kanban-id">@t.Number</span><strong>@t.Subject</strong><div><em class="priority @t.Priority.ToString().ToLower()">@t.Priority</em><small>@t.Department.Name</small></div></a>}@if(!tickets.Any()){<div class="empty-kanban">No tickets</div>}</div>}</section>
