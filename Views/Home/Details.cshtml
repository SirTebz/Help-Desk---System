@model ResolveDesk.Models.Ticket
@{ViewData["Title"]=Model.Number;var staff=User.IsInRole("Agent")||User.IsInRole("DepartmentAdmin")||User.IsInRole("SuperAdmin");}
<div class="detail"><section class="panel"><div class="ticket-head"><div><span class="ticketno">@Model.Number</span><h1>@Model.Subject</h1><em class="priority @Model.Priority.ToString().ToLower()">@Model.Priority</em> <em class="status">@Model.Status</em></div>@if(staff){<form asp-action="Transition" method="post"><input type="hidden" name="id" value="@Model.Id"/><select name="status" asp-items="Html.GetEnumSelectList<ResolveDesk.Models.TicketStatus>()"></select><button>Update status</button></form>}</div><p class="description">@Model.Description</p><div class="meta">Requested by <b>@Model.Requester.DisplayName</b> · @Model.Department.Name · Created @Model.CreatedUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</div></section><section class="panel"><h2>Conversation</h2>@foreach(var c in Model.Comments.Where(x=>staff||!x.IsInternal).OrderBy(x=>x.CreatedUtc)){<article class="comment @(c.IsInternal?"internal":"")"><b>@(c.IsInternal ? "Internal note" : "Reply")</b><small>@c.CreatedUtc.ToLocalTime().ToString("dd MMM HH:mm")</small><p>@c.Body</p></article>}<form asp-action="Comment" method="post"><input type="hidden" name="id" value="@Model.Id"/><textarea name="body" rows="4" required placeholder="Write a reply..."></textarea>@if(staff){<label class="check"><input type="checkbox" name="internalNote" value="true"/> Internal note (staff only)</label>}<button class="button">Send reply</button></form></section></div>
