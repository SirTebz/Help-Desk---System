@using System.Text.Json
@model ResolveDesk.ViewModels.DashboardVm
@{ ViewData["Title"] = "Dashboard"; var labels = Enumerable.Range(0, 14).Select(x => DateTime.UtcNow.Date.AddDays(x - 13).ToString("dd MMM")).ToArray(); }
<section class="prototype-stats">
  <article class="metric-card blue"><span class="metric-icon">▧</span><div><span>Open Tickets</span><b>@Model.Open</b><small>Live queue total</small></div></article>
  <article class="metric-card amber"><span class="metric-icon">◷</span><div><span>Assigned to me</span><b>@Model.Mine</b><small>Your active workload</small></div></article>
  <article class="metric-card green"><span class="metric-icon">✓</span><div><span>Resolved Today</span><b>@Model.ResolvedToday</b><small>Database-derived</small></div></article>
  <article class="metric-card red"><span class="metric-icon">!</span><div><span>SLA At Risk</span><b>@Model.AtRisk</b><small>Due in under 2 hours</small></div></article>
</section>
<section class="dashboard-grid">
  <article class="panel chart-panel wide"><div class="panel-title"><div><h2>Ticket Volume — Last 14 Days</h2><small>New and resolved tickets</small></div></div><div class="chart-container"><canvas id="volumeChart"></canvas></div></article>
  <article class="panel chart-panel"><div class="panel-title"><div><h2>SLA Compliance</h2><small>By priority level</small></div></div><div class="chart-container"><canvas id="slaChart"></canvas></div></article>
  <article class="panel chart-panel"><div class="panel-title"><div><h2>Department Load</h2><small>Open tickets by department</small></div></div><div class="chart-container"><canvas id="departmentChart"></canvas></div></article>
  <article class="panel activity"><div class="panel-title"><div><h2>Recent Activity</h2><small>Latest ticket updates</small></div></div>@foreach(var t in Model.Recent.Take(5)){<a class="activity-row" asp-action="Details" asp-route-id="@t.Id"><span class="activity-dot">●</span><span><b>@t.Number</b> @t.Subject</span><small>@t.UpdatedUtc.ToLocalTime().ToString("HH:mm")</small></a>}</article>
</section>
<section class="panel recent-panel"><div class="panel-title"><div><h2>Recent Tickets</h2><small>Latest tickets requiring attention</small></div><a asp-action="Tickets">View all →</a></div><div class="table-wrap"><table><thead><tr><th>Ticket</th><th>Priority</th><th>Status</th><th>Department</th><th>Requester</th><th>SLA due</th></tr></thead><tbody>@foreach(var t in Model.Recent){<tr><td><a asp-action="Details" asp-route-id="@t.Id"><b class="ticket-id">@t.Number</b><br/><span>@t.Subject</span></a></td><td><em class="priority @t.Priority.ToString().ToLower()">@t.Priority</em></td><td><em class="status">@t.Status</em></td><td>@t.Department.Name</td><td>@t.Requester.DisplayName</td><td>@t.ResolutionDueUtc.ToLocalTime().ToString("dd MMM HH:mm")</td></tr>}</tbody></table></div></section>
@section Scripts {<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script><script>window.resolveDeskCharts={labels:@Html.Raw(JsonSerializer.Serialize(labels)),created:@Html.Raw(JsonSerializer.Serialize(Model.VolumeSeries)),resolved:@Html.Raw(JsonSerializer.Serialize(Model.ResolutionSeries)),departments:@Html.Raw(JsonSerializer.Serialize(Model.DepartmentLabels)),load:@Html.Raw(JsonSerializer.Serialize(Model.DepartmentLoad)),sla:@Html.Raw(JsonSerializer.Serialize(Model.PrioritySla))};</script><script src="~/js/dashboard.js"></script>}
