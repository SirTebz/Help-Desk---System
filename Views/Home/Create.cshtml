@model ResolveDesk.ViewModels.TicketCreateVm
@{ViewData["Title"]="Create ticket";var departments=(IEnumerable<ResolveDesk.Models.Department>)ViewBag.Departments;}
<section class="panel form"><h2>Tell us what you need</h2><p>Provide enough detail for the support team to get started.</p><form method="post"><div asp-validation-summary="ModelOnly"></div><label asp-for="Subject"></label><input asp-for="Subject" placeholder="Brief description of the issue"/><span asp-validation-for="Subject"></span><label asp-for="Description"></label><textarea asp-for="Description" rows="7" placeholder="Describe the issue, its impact, and steps already tried."></textarea><span asp-validation-for="Description"></span><div class="grid"><div><label asp-for="DepartmentId">Department</label><select asp-for="DepartmentId">@foreach(var d in departments){<option value="@d.Id">@d.Name</option>}</select></div><div><label asp-for="Priority"></label><select asp-for="Priority" asp-items="Html.GetEnumSelectList<ResolveDesk.Models.TicketPriority>()"></select></div></div><label asp-for="Category"></label><input asp-for="Category"/><button class="button">Submit ticket</button></form></section><partial name="_ValidationScriptsPartial"/>
